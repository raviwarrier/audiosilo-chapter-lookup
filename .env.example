# AudioSilo Chapter Sidecar configuration
# Copy this file to .env and fill in your own values.
# .env is never committed to version control.

# AudioSilo server (corrected from spec: port 8610, not 8080)
AUDIOSILO_BASE_URL=http://192.168.68.102:8610
# Alternative: AUDIOSILO_BASE_URL=https://abooks.raviwarrier.net

# Admin API token for AudioSilo (obtain from your AudioSilo admin UI)
AUDIOSILO_API_TOKEN=your_admin_api_token_here

# AudioSilo audiobook library ID (discover via API reconnaissance)
AUDIOSILO_LIBRARY_ID=your_library_id_here

# Sidecar state database (separate from AudioSilo's own database)
SIDECAR_DATABASE=./data/chapter_sidecar.sqlite3

# Request timeouts (seconds)
AUDIOSILO_REQUEST_TIMEOUT=20
PROVIDER_REQUEST_TIMEOUT=20

# Community chapter check polling
COMMUNITY_POLL_INTERVAL=5
COMMUNITY_POLL_TIMEOUT=180

# Concurrency and rate limiting
MAX_CONCURRENT_BOOKS=1
REQUEST_DELAY_SECONDS=1

# Chapter validation tolerance (seconds)
DURATION_TOLERANCE_SECONDS=5

# Audnexus region (default US; override per installation/market)
AUDNEXUS_REGION=US

# Dry-run mode: when true, writes [title]-chapters.txt instead of updating AudioSilo
DRY_RUN=true
DRY_RUN_OUTPUT_DIR=./data/dryrun

# Direct write (testing only - bypasses API, writes directly to DB or audio file)
# Set to true to enable direct writes during testing. Always backs up first.
DIRECT_WRITE_ENABLED=false
# Method: "db" (SQLite) or "audiofile" (m4b MP4 chapters via mutagen)
DIRECT_WRITE_METHOD=db
# Path to AudioSilo SQLite database (for db method) or .m4b file (for audiofile method)
AUDIOSILO_DB_PATH=
# Directory for backups (created automatically before each write)
DIRECT_WRITE_BACKUP_DIR=./data/backups